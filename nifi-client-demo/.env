# Demo stack settings. The NiFi login below is a public default for local testing only.
NIFI_VERSION=2.12.0

# Single-user login of the NiFi image (the password must be at least 12 characters).
NIFI_USERNAME=admin
NIFI_PASSWORD=nifi-demo-password

# Address the ports are published on. 0.0.0.0 = every interface; set one IP to limit access to it.
BIND_ADDRESS=0.0.0.0
# Host name or IP that browsers use to reach this machine (besides localhost). The NiFi UI only accepts
# requests addressed to localhost:NIFI_PORT and PUBLIC_HOST:NIFI_PORT.
PUBLIC_HOST=localhost

# Host ports
NIFI_PORT=8443
APP_PORT=8080
